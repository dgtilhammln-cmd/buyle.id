<!-- HVM GLOBAL POPUP v4.0 (ULTRA LUXURY - BRANDED) -->
<style>
    /* Overlay Deep Blur */
    .hvm-luxury-overlay {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(2, 11, 9, 0.8);
        backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px);
        z-index: 10000;
        display: flex; justify-content: center; align-items: center;
        opacity: 0; visibility: hidden;
        transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1);
    }

    .hvm-luxury-overlay.active {
        opacity: 1; visibility: visible;
    }

    /* Glass Card */
    .hvm-luxury-card {
        width: 90%; max-width: 400px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(25px);
        border-radius: 40px;
        padding: 45px 30px 30px;
        text-align: center;
        position: relative;
        transform: translateY(40px) scale(0.95);
        transition: all 0.7s cubic-bezier(0.19, 1, 0.22, 1);
        box-shadow: 0 40px 80px rgba(0, 0, 0, 0.6);
        overflow: hidden;
    }

    .hvm-luxury-overlay.active .hvm-luxury-card {
        transform: translateY(0) scale(1);
    }

    /* Logo Horizontal Style (Tanpa Box) */
    .hvm-logo-horizontal {
        height: 35px; /* Sesuaikan tinggi logo horizontal Anda */
        width: auto;
        margin-bottom: 30px;
        filter: drop-shadow(0 0 10px rgba(161, 255, 90, 0.3));
    }

    /* Typography */
    .hvm-luxury-card h2 {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 900; font-size: 24px; color: #fff;
        margin-bottom: 12px; letter-spacing: -0.5px;
    }

    .hvm-luxury-card p {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 13px; color: rgba(255, 255, 255, 0.6);
        line-height: 1.7; margin-bottom: 30px;
    }

    .hvm-luxury-card b { color: #a1ff5a; }

    /* CTA Neon Button */
    .hvm-neon-btn {
        display: flex; align-items: center; justify-content: center; gap: 12px;
        padding: 16px 30px;
        background: #a1ff5a;
        border-radius: 18px;
        color: #020b09; font-weight: 900; font-size: 13px;
        text-decoration: none; text-transform: uppercase; letter-spacing: 1px;
        transition: all 0.3s;
        margin-bottom: 25px;
    }

    .hvm-neon-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(161, 255, 90, 0.4);
        background: #fff;
    }

    /* Bottom Credit */
    .hvm-popup-footer {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 10px; font-weight: 700;
        color: rgba(255, 255, 255, 0.2);
        text-transform: uppercase;
        letter-spacing: 2px;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        padding-top: 20px;
    }

    /* Close Button */
    .hvm-close-btn {
        position: absolute; top: 20px; left: 20px;
        color: rgba(255, 255, 255, 0.2);
        background: none; border: none; font-size: 16px;
        cursor: pointer; transition: 0.3s; z-index: 10;
    }
    .hvm-close-btn:hover { color: #fff; transform: rotate(90deg); }

    /* Shine Animation */
    .hvm-luxury-card::after {
        content: ''; position: absolute; top: -150%; left: -150%;
        width: 300%; height: 300%;
        background: linear-gradient(45deg, transparent, rgba(255,255,255,0.03), transparent);
        transform: rotate(45deg); animation: hvmLuxuryShine 10s infinite;
        pointer-events: none;
    }
    @keyframes hvmLuxuryShine { 0% { transform: translate(0,0) rotate(45deg); } 20% { transform: translate(150%, 150%) rotate(45deg); } 100% { transform: translate(150%, 150%) rotate(45deg); } }
</style>

<div class="hvm-luxury-overlay" id="hvmPopup">
    <div class="hvm-luxury-card">
        <!-- Close Button -->
        <button class="hvm-close-btn" onclick="closeHvmPopup()">
            <i class="fas fa-times"></i>
        </button>

        <!-- Logo Horizontal (Tanpa Box) -->
        <img src="assets/images/logo.png" alt="HVM Logo" class="hvm-logo-horizontal">
        
        <h2>Discovery HVM</h2>
        
        <p>
            Selamat datang di profil <b><?= htmlspecialchars($user['fullname']) ?></b>.<br>
            Halaman ini dibuat otomatis secara <b>GRATIS</b>
        </p>
        
        <!-- CTA Button -->
        <a href="https://bio.hvmdigital.id" class="hvm-neon-btn">
            Buat Gratis Sekarang <i class="fas fa-magic"></i>
        </a>

        <!-- Bottom Credit -->
        <div class="hvm-popup-footer">
            bio by hvmdigital.id
        </div>
    </div>
</div>

<script>
    function showHvmPopup() {
        document.getElementById('hvmPopup').classList.add('active');
    }

    function closeHvmPopup() {
        document.getElementById('hvmPopup').classList.remove('active');
    }

    window.addEventListener('load', () => {
        setTimeout(showHvmPopup, 1200);
    });

    // Close on backdrop click
    window.addEventListener('click', (e) => {
        const overlay = document.getElementById('hvmPopup');
        if (e.target === overlay) closeHvmPopup();
    });
</script>