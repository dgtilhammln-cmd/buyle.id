:root {
    --bg: #050505;
    --card-bg: rgba(255, 255, 255, 0.04);
    --border: rgba(255, 255, 255, 0.08);
    --neon: #a1ff5a;
    --text-main: #ffffff;
    --text-dim: #94a3b8;
}

* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

body {
    margin: 0;
    padding: 0;
    background-color: var(--bg);
    color: var(--text-main);
    font-family: 'Plus Jakarta Sans', sans-serif;
    line-height: 1.5;
}

.main-wrapper {
    max-width: 500px;
    margin: 0 auto;
    min-height: 100vh;
    padding-bottom: 50px;
    background: radial-gradient(circle at top right, rgba(161, 255, 90, 0.05), transparent),
                radial-gradient(circle at bottom left, rgba(78, 253, 196, 0.03), transparent);
}

.container { padding: 0 20px; }

/* HEADER */
.header-v3 {
    text-align: center;
    position: relative;
    margin-bottom: 30px;
}

.cover-photo {
    height: 180px;
    background-size: cover;
    background-position: center;
    position: relative;
}

.overlay-gradient {
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, transparent, var(--bg));
}

.profile-meta {
    margin-top: -60px;
    position: relative;
    z-index: 2;
}

.avatar-ring {
    width: 110px; height: 110px;
    margin: 0 auto 15px;
    padding: 5px;
    background: linear-gradient(135deg, var(--neon), #4efdc4);
    border-radius: 42px; /* Smooth Squircle */
}

.avatar-ring img {
    width: 100%; height: 100%;
    object-fit: cover;
    border-radius: 38px;
    border: 4px solid var(--bg);
}

.name { font-size: 24px; font-weight: 800; margin: 0; letter-spacing: -0.5px; }
.verified-ico { color: #38bdf8; font-size: 16px; margin-left: 5px; }
.nickname { color: var(--text-dim); font-size: 14px; font-weight: 600; margin: 5px 0 15px; }

.info-badges { display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; }
.badge {
    background: var(--card-bg);
    border: 1px solid var(--border);
    padding: 6px 14px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 700;
    color: var(--text-dim);
}

/* DRIVE CARD */
.premium-drive-card {
    background: linear-gradient(135deg, #111, #000);
    border: 1px solid var(--neon);
    padding: 20px;
    border-radius: 25px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    color: #fff;
    margin-bottom: 25px;
    box-shadow: 0 15px 30px rgba(161, 255, 90, 0.1);
}

.drive-content { display: flex; align-items: center; gap: 15px; }
.drive-icon-box {
    width: 45px; height: 45px;
    background: var(--neon);
    color: #000;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
}
.drive-text h3 { margin: 0; font-size: 15px; font-weight: 800; }
.drive-text p { margin: 0; font-size: 11px; color: var(--text-dim); font-weight: 600; }

/* TIKTOK SLIDER */
.section-container { margin: 25px 0; }
.section-title {
    padding: 0 20px; margin-bottom: 15px;
    font-size: 12px; font-weight: 800; color: var(--text-dim);
    text-transform: uppercase; letter-spacing: 1.5px;
}

.tiktok-horizontal-scroll {
    display: flex;
    overflow-x: auto;
    padding: 0 20px;
    gap: 12px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
}
.tiktok-horizontal-scroll::-webkit-scrollbar { display: none; }

.tiktok-card {
    min-width: 140px; height: 210px;
    border-radius: 20px;
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
    scroll-snap-align: start;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
}

.card-overlay {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.3);
    display: flex; align-items: center; justify-content: center;
}
.card-overlay i {
    font-size: 24px; color: #fff;
    opacity: 0.8; text-shadow: 0 4px 10px rgba(0,0,0,0.5);
}

/* SOCIAL TILES */
.social-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 12px;
}

.social-tile {
    height: 60px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 20px;
    display: flex; align-items: center; justify-content: center;
    font-size: 22px;
    color: #fff;
    text-decoration: none;
    transition: 0.3s;
}
.social-tile.ig:hover { color: #e1306c; border-color: #e1306c; }
.social-tile.wa:hover { color: #25d366; border-color: #25d366; }

/* LINK CARDS */
.stack-vertical { display: flex; flex-direction: column; gap: 12px; }
.link-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    padding: 14px;
    border-radius: 24px;
    display: flex;
    align-items: center;
    gap: 15px;
    text-decoration: none;
    transition: 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.link-card:hover {
    background: rgba(255,255,255,0.07);
    transform: translateY(-4px) scale(1.01);
    border-color: rgba(255,255,255,0.2);
}

.link-img-wrapper {
    width: 50px; height: 50px;
    border-radius: 14px;
    overflow: hidden;
    flex-shrink: 0;
}
.link-img-wrapper img { width: 100%; height: 100%; object-fit: cover; }
.link-img-placeholder {
    width: 100%; height: 100%;
    background: #111; color: var(--neon);
    display: flex; align-items: center; justify-content: center; font-size: 18px;
}

.link-info { flex-grow: 1; }
.link-info h4 { margin: 0; font-size: 15px; font-weight: 700; color: #fff; }
.link-info p { margin: 2px 0 0; font-size: 12px; color: var(--text-dim); font-weight: 500; }
.link-chevron { color: var(--text-dim); font-size: 12px; }

/* FOOTER */
.footer-v3 {
    text-align: center;
    margin-top: 40px;
    padding: 20px;
}
.footer-v3 a {
    text-decoration: none;
    color: var(--text-dim);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
}
.hvm-text { color: var(--neon); }

/* ANIMATIONS */
@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

.anim-fade-up { animation: fadeInUp 0.8s ease forwards; }
.anim-reveal { opacity: 0; animation: fadeInUp 0.8s ease forwards; }

.anim-pulse {
    animation: pulse 2s infinite;
}
@keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(161, 255, 90, 0.4); }
    70% { box-shadow: 0 0 0 15px rgba(161, 255, 90, 0); }
    100% { box-shadow: 0 0 0 0 rgba(161, 255, 90, 0); }
}

/* Responsive fixes for small phones */
@media (max-width: 370px) {
    .name { font-size: 20px; }
    .tiktok-card { min-width: 120px; height: 180px; }
    .social-tile { height: 50px; }
}