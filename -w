            // ── Category Swiper (Desktop & Mobile) ──
            if (document.querySelector('#catsSwiperDesktop')) {
                const catsSwiper = new Swiper('#catsSwiperDesktop', {
                    slidesPerView: 'auto',
                    spaceBetween: 12,
                    grabCursor: true,
                    freeMode: true,
